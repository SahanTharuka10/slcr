{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?path=:path*" }
  ],
  "crons": [
    { "path": "/api/keepalive", "schedule": "0 3 * * *" }
  ]
}
