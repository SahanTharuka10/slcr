{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/overlay/:matchId",
      "destination": "/pages/overlay.html?match=:matchId&obs=1"
    }
  ],
  "headers": [
    {
      "source": "/js/cloud-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
